# Backend configuration. Copy this file to `.env` in the project directory
# (next to `docker-compose.yml`) or to `backend/.env`, and uncomment what you
# want to change. Everything is optional.
#
# Precedence, highest first:
#   1. real environment variables (docker-compose, CI, an inline `VAR=x cmd`)
#   2. this file, read by the backend at import time
#   3. built-in defaults
#
# `.env` is gitignored; this example file is tracked.

# --- model -------------------------------------------------------------------

# Which published OpenAI checkpoint to download and load. The matching
# architecture config is selected automatically, and the registry id becomes
# `openai-<size, lowercased>` (e.g. `openai-355m`).
#   124M (default, ~500 MB) | 355M (~1.5 GB) | 774M (~3 GB) | 1558M (~6 GB)
# GPT2_MODEL_SIZE=124M

# Set to 0 to skip downloading and loading the OpenAI weights entirely. The
# entry is still listed in /api/models, with ready=false.
# GPT2_LOAD_OPENAI_MODEL=1

# Where the checkpoint is cached. Defaults to backend/checkpoints/gpt2.
# GPT2_CHECKPOINT_DIR=backend/checkpoints/gpt2

# --- scratch model / training -----------------------------------------------

# Path to the optional from-scratch checkpoint (see scripts/train_small.py).
# Defaults to backend/checkpoints/scratch.pt.
# GPT2_SCRATCH_CHECKPOINT=backend/checkpoints/scratch.pt

# Training corpus for scripts/train_small.py.
# GPT2_TEXT_FILE=the-verdict.txt

# Use the tiny test config for the scratch entry's placeholder description.
# Only affects how an unloadable entry is described; tests use it.
# GPT2_USE_SMALL_MODEL=0

# --- runtime -----------------------------------------------------------------

# auto (default) | cpu | cuda | mps | cuda:0 ...
# GPT2_DEVICE=auto

# Comma-separated browser origins allowed to call the API. Defaults to the
# Vite dev server (http://localhost:5173 and friends).
# GPT2_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- tests only --------------------------------------------------------------

# HuggingFace model the slow parity tests compare against.
# HF_GPT2_ID=openai-community/gpt2
