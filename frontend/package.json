{
  "name": "gpt2-visualizer-frontend",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "smoke:static": "node scripts/smoke.mjs --static",
    "inspect:lens": "node scripts/smoke.mjs --inspect=lens",
    "build:static": "npm run check:traces && tsc -b && vite build --mode static",
    "preview:static": "vite preview --mode static --outDir dist-static",
    "check:traces": "node scripts/check-traces.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "framer-motion": "^11.11.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
